<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Opencart App Test Regression Suite" verbose="4" thread-count="10"
	parallel="tests">
	<!--verbose is used to print the logs in the console-->

	<listeners>
		<listener
			class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<listener
			class-name="com.qa.opencart.listeners.TestAllureListener" />
		<!-- <listener
		class-name="com.qa.opencart.listeners.AnnotationTransformer" 
			/> -->

	</listeners>

	<test name="Login Page Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="126.0" />
		<parameter name="testname" value="Login Page Test" />

		<classes>
			<class name="com.qa.opencart.tests.LoginPageTest" />
		</classes>
	</test>

	<test name="Login Page Test_Brave">			<!--name cannot be same for two tests, so give different name for the test -->
		<parameter name="browser" value="Brave" />
		<parameter name="browserversion" value="125.0" />
		<parameter name="testname" value="Login Page Test" />

		<classes>
			<class name="com.qa.opencart.tests.LoginPageTest" />
		</classes>
	</test>


	<test name="Accounts Page Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="browserversion" value="123.0" />
		<parameter name="testname" value="Accounts Page Test" />

		<classes>
			<class name="com.qa.opencart.tests.AccountsPageTest" />
		</classes>
	</test>

	<test name="Search Test_Brave">
		<parameter name="browser" value="Brave" />
		<parameter name="browserversion" value="124.0" />
		<parameter name="testname" value="Search Page Test" />

		<classes>
			<class name="com.qa.opencart.tests.SearchTest" />
		</classes>
	</test>


	<!--<test name="ProductInfo Page Test_Brave">
		<parameter name="browser" value="Brave" />
		<parameter name="browserversion" value="105.0" />
		<parameter name="testname" value="Product Info Page Test" />

		<classes>
			<class name="com.qa.opencart.tests.ProductInfoPageTest" />   this is the class name of the test case which is to be executed 
		</classes>
	</test>-->

