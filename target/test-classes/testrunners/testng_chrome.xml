<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Opencart App Test Regression Suite" verbose="4"
	thread-count="3" parallel="tests">

	<test name="Login Page Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="testname" value="Login Page Test_chrome" />
		<classes>
			<class name="com.qa.opencart.tests.LoginPageTest" />
		</classes>
	</test>


	<test name="Accounts Page Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="testname" value="Accounts Page Test_chrome" />
		<classes>
			<class name="com.qa.opencart.tests.AccountsPageTest" />
		</classes>
	</test>

	<test name="Search Test_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="testname" value="Search Test_chrome" />
		<classes>
			<class name="com.qa.opencart.tests.SearchTest" />
		</classes>
	</test>
	<test name="product_info_chrome">
		<parameter name="browser" value="chrome" />
		<parameter name="testname" value="product_info_chrome" />
		<classes>
			<class name="com.qa.opencart.tests.ProductInfoPageTest" />
		</classes>
	</test>

</suite>	
